{
  "description": "플러그인 환경변수 주입 + 차트/PDF 내장 스크립트 사용 강제",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/inject-plugin-root.sh",
            "timeout": 5,
            "statusMessage": "Smart Briefing 플러그인 초기화 중..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/validate-chart-code.py",
            "timeout": 15,
            "statusMessage": "차트/PDF 코드 검증 중..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/validate-chart-code.py",
            "timeout": 15,
            "statusMessage": "차트/PDF 코드 검증 중..."
          }
        ]
      }
    ]
  }
}
